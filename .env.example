# DeepSeek API Key (required) - get from https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek API Base URL (default)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model to use (deepseek-chat for V3, deepseek-reasoner for R1, deepseek-v4-flash for V4-Flash)
DEEPSEEK_MODEL=deepseek-v4-flash

# Finnhub API Key (optional - for US stock news sentiment)
# Get free key at https://finnhub.io
FINNHUB_API_KEY=

# FRED API Key (optional - for US macroeconomic data)
# Get free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
